[TEMPLATE]
# Server only. Copy to .env and configure locally.
TYPESAFE_AI_API_KEY=
PORT=4318

# Optional image sources. A source stays inactive until its key is set.
# Openverse needs no key. Pinterest works keyless (rate limited) or with your
# browser's Pinterest cookie header for a higher tier. Get keys at:
#   Unsplash: https://unsplash.com/developers  (UNSPLASH_ACCESS_KEY)
#   Pexels:   https://www.pexels.com/api/      (PEXELS_API_KEY)
#   Flickr:   https://www.flickr.com/services/apps/create/ (FLICKR_API_KEY)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
FLICKR_API_KEY=
PINTEREST_COOKIE=
# Pixabay: https://pixabay.com/api/docs/ (PIXABAY_API_KEY) unlocks Pixabay video clips
PIXABAY_API_KEY=
